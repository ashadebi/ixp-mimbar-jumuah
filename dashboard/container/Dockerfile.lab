FROM mimbar-bird:2.19.2
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/* && mkdir -p /etc/bird /var/lib/mimbar /usr/local/sbin
COPY remote-agent.py /usr/local/sbin/mimbar-deploy
COPY tests/container_lab.py /lab.py
RUN chmod 755 /usr/local/sbin/mimbar-deploy
ENTRYPOINT ["python3", "/lab.py"]
